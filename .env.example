# 部署配置示例：复制为 .env 后按需修改（cp .env.example .env）

# 应用基础配置
APP_NAME="blog"
# 完整公开地址（含协议），用于后端生成链接 / 邮件等
APP_DOMAIN=https://blog.example.com

# Nginx 的 server_name（裸域名，不带协议）
# 仅用于脚本生成 Nginx server_name 与后端配置；要让外网通过该域名访问，
# 需自行在域名服务商处把 DNS A/AAAA 解析到服务器公网 IP（本脚本不负责 DNS）。
NGINX_SERVER_NAME=blog.example.com
# 是否启用 HTTPS：http 或 https。https 时证书缺失则由 deploy/certbot.sh 自动签发（先 HTTP 拉起 nginx 供 ACME 挑战，再 certonly），已存在则续期。
NGINX_TLS=http
# 自动签发/续期开关（仅 NGINX_TLS=https 时生效）：on（默认）/ off
NGINX_TLS_AUTO=on

# 发布到宿主机的端口（容器内固定 80/443）。rootless / rootful 由运行方式自动判断，无需在此设置：
#   - 普通用户 Podman 为 rootless，不能绑 1024 以下，deploy.sh 自动回落 8080/8443；
#   - sudo 运行、或 docker root daemon 为 rootful，直接绑 80/443，无需手动端口转发。
# 要 rootless 下也拿真 80/443：设 net.ipv4.ip_unprivileged_port_start=0，或宿主做 80→8080/443→8443 转发。
HTTP_PORT=80
HTTPS_PORT=443

# 自行部署：运行 ./deploy.sh self
# 打包产物并生成部署步骤文档 SELF_HOST_STEPS.md，脚本不替你运行任何服务 / 签发证书。
# 以下变量在目标机上填不填、怎么填，由你自行决定（取决于你选容器 / 原生 / 已有实例），详见包内步骤文档：
# DB_HOST / REDIS_HOST / APP_REDIS_HOST / NUXT_BACKEND_URL

# 数据库（PostgreSQL）
POSTGRES_USER=blog
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=blog
# 后端连接数据库用的地址（容器服务名）
DB_HOST=postgres
DB_PORT=5432
# 复用上面的 POSTGRES_*（source .env 时会被展开）
DB_USER=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT 密钥（请改为一段足够长的随机字符串）
JWT_SECRET='please_change_this_to_a_long_random_string'

# 邮件（SMTP，按需修改）
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=your-email@example.com
# Let's Encrypt 注册邮箱（部署脚本自动签发证书时使用）；留空则复用上面的 EMAIL_FROM
CERTBOT_EMAIL=your-email@example.com

# 大模型 API Key（按需，可留空）
MODEL_API_KEY=

# 对象存储 RustFS（S3 兼容，前端图片等静态资源所需，必配）
RUSTFS_ACCESS_KEY_ID=change_me_access_key
RUSTFS_SECRET_ACCESS_KEY=change_me_secret_key
# 前端/浏览器加载图片与预签名 URL 的基址，必填且须为公网 https://（容器服务名仅供后端内网，无法供前端）。
# 部署脚本按域名在容器内 Nginx 加反代：API 用该域名、控制台自动加 admin. 前缀，并一并申请证书。
RUSTFS_ENDPOINT=https://oos.example.com/
