server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};

    # 动态解析上游：backend/frontend 容器重建后 IP 会变化，
    # 用 resolver + 变量形式的 proxy_pass 让 nginx 每次请求重新解析，
    # 避免缓存旧 IP 导致 502 Bad Gateway。
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    resolver_timeout 5s;

    # 客户端请求体最大大小（图片 / 附件上传）
    client_max_body_size 300m;

    # Let's Encrypt 的 ACME HTTP-01 挑战目录
    # certbot --webroot 会把校验文件写到 /var/www/certbot/.well-known/acme-challenge/
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    # 前端（Nuxt SSR）
    location / {
        set $upstream_frontend http://frontend:3000;
        proxy_pass $upstream_frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # 后端 API
    location /api/v1/ {
        set $upstream_backend http://backend:8000;
        proxy_pass $upstream_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
